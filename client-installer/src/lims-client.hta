<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>PlexiQ LIMS Client</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #f0f2f5; font-family: 'Segoe UI', sans-serif; }
    #offline { display: none; position: fixed; top: 0; left: 0; right: 0; background: #e74c3c; color: #fff; text-align: center; padding: 8px; font-size: 13px; z-index: 9999; }
    #loading { position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: #0f1923; color: #fff; flex-direction: column; z-index: 9998; }
    #loading .spinner { width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #00d4aa; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 16px; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #loading p { font-size: 14px; color: #8ba0b8; }
    iframe { position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; border: none; }
</style>
<HTA:APPLICATION
    ID="PlexiQLIMS"
    APPLICATIONNAME="PlexiQ LIMS Client"
    BORDER="none"
    CAPTION="yes"
    ICON="/assets/icon.ico"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    NAVIGABLE="yes"
    SCROLL="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="maximize"
>
<script language="VBScript">
Sub LoadConfig
    Dim fso, config, url
    Set fso = CreateObject("Scripting.FileSystemObject")
    configPath = Replace(document.location.pathname, "lims-client.hta", "") & "config.ini"
    If fso.FileExists(configPath) Then
        Set config = fso.OpenTextFile(configPath, 1)
        Do While Not config.AtEndOfStream
            line = Trim(config.ReadLine)
            If Left(line, 5) = "URL=" Then
                serverUrl = Mid(line, 5)
            End If
        Loop
        config.Close
    End If
End Sub

Sub Window_OnLoad
    Call LoadConfig
    If serverUrl = "" Then serverUrl = "http://localhost:8080"
    document.getElementById("limsFrame").src = serverUrl & "/client/login"
    document.getElementById("loading").style.display = "none"
End Sub
</script>
</head>
<body>
<div id="offline">⚠ Connection lost. Reconnecting...</div>
<div id="loading">
    <div class="spinner"></div>
    <p>Connecting to PlexiQ LIMS...</p>
</div>
<iframe id="limsFrame" src="about:blank"></iframe>
</body>
</html>
