#!/usr/bin/env php
<?php
/**
 * Advanced LIMS Console
 * Usage: php bin/console <command>
 *
 * Commands:
 *   sap:sync     Run SAP HANA sync
 *   key:generate Generate application key
 */

if (php_sapi_name() !== 'cli') {
    die('This script must be run from the command line.');
}

require_once __DIR__ . '/../vendor/autoload.php';

// Load .env
$envFile = __DIR__ . '/../.env';
if (file_exists($envFile)) {
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        if (str_contains($line, '=')) {
            [$key, $value] = explode('=', $line, 2);
            $_ENV[trim($key)] = trim($value);
            putenv(trim($key) . '=' . trim($value));
        }
    }
}

require_once __DIR__ . '/../app/Helpers/helpers.php';

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'sap:sync':
        $syncService = new \App\Services\SapSyncService();
        $results = $syncService->runScheduledSync();
        echo "[" . date('Y-m-d H:i:s') . "] SAP Sync completed:\n";
        foreach ($results as $key => $result) {
            $status = $result['success'] ? 'OK' : 'FAIL';
            echo "  {$key}: [{$status}] {$result['message']}\n";
        }
        break;

    case 'key:generate':
        $key = 'base64:' . base64_encode(random_bytes(32));
        $envContent = file_get_contents($envFile);
        if (preg_match('/APP_KEY=.*/', $envContent)) {
            $envContent = preg_replace('/APP_KEY=.*/', "APP_KEY={$key}", $envContent);
        } else {
            $envContent .= "\nAPP_KEY={$key}\n";
        }
        file_put_contents($envFile, $envContent);
        echo "Application key generated: {$key}\n";
        break;

    case 'cache:clear':
        \App\Helpers\Cache::flush();
        echo "Application cache cleared.\n";
        break;

    case 'queue:work':
        $args = array_slice($argv, 2);
        array_unshift($args, 'worker');
        require __DIR__ . '/worker.php';
        break;

    case 'queue:monitor':
        $pending = \App\Helpers\JobQueue::countPending();
        $failed = \App\Helpers\JobQueue::countFailed();
        echo "Queue monitor\n";
        echo "  Pending: {$pending}\n";
        echo "  Failed:  {$failed}\n";
        break;

    case 'backup:run':
        // php bin/console backup:run [--type=manual]
        $type = 'manual';
        foreach (array_slice($argv, 2) as $arg) {
            if (str_starts_with($arg, '--type=')) {
                $type = substr($arg, 7);
            }
        }
        try {
            $meta = (new \App\Services\BackupService())->create($type);
            echo 'Backup created: ' . $meta['file'] . ' (' . round($meta['size'] / 1024, 1) . " KB)\n";
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Backup failed: ' . $e->getMessage() . "\n");
            exit(1);
        }
        break;

    case 'backup:list':
        $backups = (new \App\Services\BackupService())->list();
        if (empty($backups)) {
            echo "No backups found.\n";
            break;
        }
        printf("%-40s %-8s %-19s %s\n", 'FILE', 'TYPE', 'CREATED', 'SIZE');
        foreach ($backups as $b) {
            printf("%-40s %-8s %-19s %.1f KB\n", $b['file'], $b['type'], date('Y-m-d H:i:s', strtotime($b['created_at'])), $b['size'] / 1024);
        }
        break;

    case 'backup:restore':
        // php bin/console backup:restore <file.sql>
        if (empty($argv[2])) {
            fwrite(STDERR, "Usage: php bin/console backup:restore <backup.sql>\n");
            exit(1);
        }
        try {
            $result = (new \App\Services\BackupService())->restore($argv[2]);
            echo 'Backup restored: ' . $result['file'] . ' (took ' . round($result['duration_ms'] / 1000, 1) . "s)\n";
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Restore failed: ' . $e->getMessage() . "\n");
            exit(1);
        }
        break;

    case 'backup:prune':
        $removed = (new \App\Services\BackupService())->prune();
        echo "Pruned {$removed} old backup(s).\n";
        break;

    case 'help':
    default:
        echo "Advanced LIMS Console\n";
        echo "Usage: php bin/console <command>\n\n";
        echo "Commands:\n";
        echo "  sap:sync       Run SAP HANA scheduled sync\n";
        echo "  key:generate   Generate application encryption key\n";
        echo "  cache:clear    Flush the application cache\n";
        echo "  queue:work     Start the async job worker (see bin/worker.php --help)\n";
        echo "  queue:monitor  Show pending/failed job counts\n";
        echo "  backup:run     Create a database backup (--type=manual|scheduled)\n";
        echo "  backup:list    List stored backups\n";
        echo "  backup:restore Restore a backup (destructive)\n";
        echo "  backup:prune   Delete old backups beyond retention\n";
        break;
}
