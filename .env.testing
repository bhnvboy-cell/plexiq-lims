# PlexiQ LIMS - Testing Environment Configuration
APP_NAME=PlexiQ LIMS
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (PostgreSQL 16) - separate test database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=limsdb_test
DB_USERNAME=lims_user
DB_PASSWORD=lims_test_pass

# Session
SESSION_DRIVER=array
SESSION_LIFETIME=120

# COA Configuration
COA_STORAGE_PATH=storage/coa
COA_DEFAULT_TEMPLATE=standard
COMPANY_NAME=PlexiQ LIMS Test
COMPANY_ADDRESS=123 Lab Street, Science City
COMPANY_PHONE=+1-555-0000
COMPANY_EMAIL=test@plexiq.ai

# SAP (disabled in tests)
SAP_HANA_SYNC_ENABLED=false

# Application Key
APP_KEY=base64:TestingKeyDoNotUseInProduction1234567890
