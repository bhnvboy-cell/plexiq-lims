# ============================================================
# ADVANCED LIMS - Environment Configuration
# ============================================================

# Application
APP_NAME=AdvancedLIMS
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/lims

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=limsdb
DB_USERNAME=lims_user
DB_PASSWORD=changeme_secure_password

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# COA Configuration
COA_STORAGE_PATH=storage/coa
COA_DEFAULT_TEMPLATE=standard
COMPANY_NAME=Your Laboratory Name
COMPANY_ADDRESS=123 Lab Street, Science City
COMPANY_PHONE=+1-555-0000
COMPANY_EMAIL=info@yourlab.com

# SAP HANA Configuration
SAP_HANA_HOST=192.168.1.100
SAP_HANA_PORT=30015
SAP_HANA_USERNAME=SYSTEM
SAP_HANA_PASSWORD=
SAP_HANA_ODATA_URL=http://192.168.1.100:8000/sap/opu/odata/
SAP_HANA_USE_ODBC=false
SAP_HANA_SYNC_ENABLED=false
SAP_HANA_SYNC_INTERVAL=5

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lims.local
MAIL_FROM_NAME=LIMS

# Application Key (generate with: php bin/console key:generate)
APP_KEY=base64:ReplaceWithGeneratedKey
