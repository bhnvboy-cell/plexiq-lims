# PlexiQ LIMS - Production environment template
# Copy to .env and fill in real values. NEVER commit a real .env.

APP_NAME=PlexiQ LIMS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://lims.example.com

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=limsdb
DB_USERNAME=plexiq_app
DB_PASSWORD=CHANGE_ME

# Session: 'file' is fine for small deployments; use 'database' when running
# multiple web servers behind a load balancer.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache: 'file' (single node) or 'redis' (multi-node).
CACHE_DRIVER=file
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=

# Queue: 'database' (jobs table, needs the queue worker running) or leave empty
# to process synchronously.
QUEUE_DRIVER=database
QUEUE_DEFAULT=default

# COA Configuration
COMPANY_NAME=PlexiQ Laboratory
COMPANY_ADDRESS=123 Lab Street, Science City
COMPANY_PHONE=+1-555-0100
COMPANY_EMAIL=info@plexiq-lims.example.com

# SAP HANA Configuration (only if SAP sync is enabled)
SAP_HANA_HOST=192.168.1.100
SAP_HANA_PORT=30015
SAP_HANA_USERNAME=SYSTEM
SAP_HANA_PASSWORD=
SAP_HANA_ODATA_URL=http://192.168.1.100:8000/sap/opu/odata/
SAP_HANA_USE_ODBC=false
SAP_HANA_SYNC_ENABLED=false
SAP_HANA_SYNC_INTERVAL=5

# Application Key - generate a real one: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=base64:REPLACE_WITH_A_GENERATED_KEY
